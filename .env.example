PSE_PROJECT_ROOT=.
PSE_RANDOM_SEED=42
PSE_LOG_LEVEL=INFO

# Optional official platform API credentials. Never commit real values.
X_BEARER_TOKEN=
THREADS_ACCESS_TOKEN=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v24.0
TIKTOK_RESEARCH_ACCESS_TOKEN=

# Fantasy league sync. Sleeper is read-only and needs no API token.
PSE_SLEEPER_USERNAME=
# ESPN private leagues use browser session cookies via the optional espn-api adapter.
# Never commit populated values.
PSE_ESPN_S2=
PSE_ESPN_SWID=

# Product API and Gemini frontend
# Development/test compatibility mode. An explicitly supplied projections_path also forces this
# unverified path authority even when champion environment variables are present.
PSE_PROJECTION_SOURCE_MODE=path
# The development file may contain multiple scoring contracts, one row per
# (scoring_contract_id, player_id). Python selects the exact league contract before valuation.
PSE_PROJECTIONS_PATH=artifacts/predictions/product_player_values.csv

# Production serving mode. Set PSE_PROJECTION_SOURCE_MODE=champion only after a human-approved,
# activation-eligible production manifest has been registered and its champion pointer promoted.
# Champion mode never falls back to PSE_PROJECTIONS_PATH. The bundle root must be the immutable
# directory containing the exact files named by the champion manifest.
PSE_ARTIFACT_REGISTRY_ROOT=artifacts/registry
PSE_PRODUCTION_BUNDLE_ROOT=
PSE_PROJECTION_CHAMPION_TARGET=preseason_multicontract_player_values_2026

# NFL Hub is observational. Leave blank by default so it cannot inherit an arbitrary fantasy
# scoring contract. Point this only at an intentionally single-contract read-only context file.
PSE_NFL_HUB_PROJECTIONS_PATH=
PSE_SCHEDULES_PATH=data/raw/nflverse/schedules.csv
# Fail closed unless the configured schedule is explicitly classified.
PSE_SCHEDULES_DATA_MODE=UNVERIFIED
PSE_TEAM_CONTEXT_PATH=data/processed/team_play_structure_2025.parquet
PSE_BENCHMARK_ROOT=artifacts/reports/benchmark_real
PSE_CONFORMAL_ROOT=artifacts/reports/conformal_real
PSE_OPPORTUNITY_REPORT_ROOT=artifacts/reports/opportunity_ablation_real
PSE_HISTORICAL_SOURCE_REPORT_ROOT=artifacts/reports/historical_source_ablation_hardened
PSE_LEAGUE_STORE=data/product/leagues
PSE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PSE_API_BASE_URL=http://localhost:8000
GEMINI_API_KEY=
# Current GA default for the optional copilot. The deterministic product works without this key.
GEMINI_MODEL=gemini-3.7-flash
