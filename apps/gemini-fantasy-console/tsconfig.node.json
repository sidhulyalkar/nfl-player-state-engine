{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "outDir": "dist-server",
    "tsBuildInfoFile": "dist-server/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "server", "shared"]
}
